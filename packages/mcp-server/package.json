{
  "name": "@apature/mcp-server",
  "version": "0.1.0",
  "description": "Apature Bastion server: agent-facing MCP tools (design_review, design_review_get) over the Verdict review surface.",
  "license": "MIT",
  "author": "Aditya Prathapa",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apatureai/bastion.git",
    "directory": "packages/mcp-server"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "start": "node dist/boot.js",
    "prepublishOnly": "tsc -b"
  },
  "dependencies": {
    "@apature/mcp-types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jose": "^6.2.3",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/pg": "^8.15.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "bin": {
    "mcp-review-server": "./dist/boot.js",
    "mcp-review-local": "./dist/local-stdio.js",
    "mcp-review": "./dist/review-cli.js"
  }
}
