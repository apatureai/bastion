{
  "name": "@apature/mcp-review-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Apature MCP Review - in-loop, read-only design review for coding agents over MCP",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1"
    }
  }
}
